{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "table",
            "message": "Use <DataTable> from the design system instead of <table>."
          },
          {
            "element": "dialog",
            "message": "Use <Dialog> from the design system instead of <dialog>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          },
          {
            "element": "textarea",
            "message": "Use <Textarea> from the design system instead of <textarea>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/admin/DataTable/**",
              "components/admin/PageHeader/**",
              "components/admin/Pagination/**",
              "components/admin/SidebarNav/**",
              "components/admin/StatCard/**",
              "components/admin/Toolbar/**",
              "components/brand/Logo/**",
              "components/marketing/CTASection/**",
              "components/marketing/CourseCard/**",
              "components/marketing/Footer/**",
              "components/marketing/Hero/**",
              "components/marketing/Navbar/**",
              "components/marketing/PricingCard/**",
              "components/marketing/StatBlock/**",
              "components/marketing/TestimonialCard/**",
              "components/primitives/Alert/**",
              "components/primitives/Avatar/**",
              "components/primitives/Badge/**",
              "components/primitives/Button/**",
              "components/primitives/Card/**",
              "components/primitives/Checkbox/**",
              "components/primitives/Dialog/**",
              "components/primitives/EmptyState/**",
              "components/primitives/FormField/**",
              "components/primitives/IconButton/**",
              "components/primitives/Input/**",
              "components/primitives/RadioGroup/**",
              "components/primitives/Select/**",
              "components/primitives/Spinner/**",
              "components/primitives/Switch/**",
              "components/primitives/Tabs/**",
              "components/primitives/Textarea/**",
              "components/primitives/Tooltip/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|onClose|className|id|style|children|variant|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: title, icon, onClose, className, id, style, children, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:danger|success|info|warning)$/]",
        "message": "<Alert> variant must be one of 'danger' | 'success' | 'info' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|name|className|id|style|children|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, name, className, id, style, children, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|className|id|children|color|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: style, className, id, children, color, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:danger|success|navy|purple|orange|neutral)$/]",
        "message": "<Badge> color must be one of 'danger' | 'success' | 'navy' | 'purple' | 'orange' | 'neutral'."
