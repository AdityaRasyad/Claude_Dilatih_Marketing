    {
      "id": "susun-jawaban",
      "name": "Susun Jawaban",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1960, 20],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Susun teks jawaban dari baris program/faq yang terbaca.\n// Placeholder — ganti sesuai template resmi di copy-percakapan.md §2-3.\nconst jalur = items[0]?.json?.jalur || 'bnsp';\nconst daftarProgram = items.map(i => `- ${i.json.nama || i.json.ringkasan || '(tanpa nama)'}`).join('\\n');\nconst jawaban = daftarProgram\n  ? `Berikut program ${jalur} yang tersedia:\\n${daftarProgram}\\n\\nAda yang mau ditanyakan lebih lanjut?`\n  : `Untuk saat ini kami belum punya info lengkap soal ${jalur}, tim kami akan bantu langsung ya.`;\nreturn [{ json: { jalur, jawaban } }];"
      }
    },
