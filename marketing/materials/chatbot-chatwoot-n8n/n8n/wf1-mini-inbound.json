      "typeVersion": 3.2,
      "position": [1300, 60],
      "parameters": {
        "rules": {
          "values": [
            { "outputKey": "1-bnsp", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "combinator": "and", "conditions": [{ "id": "p1", "leftValue": "={{ $('Webhook Chatwoot').item.json.body.message.content.trim() }}", "rightValue": "1", "operator": { "type": "string", "operation": "equals" } }] } },
            { "outputKey": "2-workshop", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "combinator": "and", "conditions": [{ "id": "p2", "leftValue": "={{ $('Webhook Chatwoot').item.json.body.message.content.trim() }}", "rightValue": "2", "operator": { "type": "string", "operation": "equals" } }] } },
            { "outputKey": "3-b2b", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "combinator": "and", "conditions": [{ "id": "p3", "leftValue": "={{ $('Webhook Chatwoot').item.json.body.message.content.trim() }}", "rightValue": "3", "operator": { "type": "string", "operation": "equals" } }] } },
            { "outputKey": "4-technical", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "combinator": "and", "conditions": [{ "id": "p4", "leftValue": "={{ $('Webhook Chatwoot').item.json.body.message.content.trim() }}", "rightValue": "4", "operator": { "type": "string", "operation": "equals" } }] } }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "notes": "Output 'extra' (angka tidak dikenali) tidak disambungkan — pesan diabaikan sampai user membalas 1-4. Bisa disambungkan ke Kirim Menu lagi kalau mau re-prompt."
